  "description": "My Electron application description",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "npm run build:mcp && electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "clean:mcp": "rm -rf dist/mcp",
    "build:mcp": "tsc -p tsconfig.mcp.json",
    "prebuild:mcp": "npm run clean:mcp",
    "mcp": "node ./dist/mcp/client.js ./dist/mcp/server.js",
    "mcp:dev": "npm run build:mcp && npm run mcp"
